MQTT_SERVER_USERNAME=demo_user
MQTT_SERVER_PASSWORD=replace_with_a_local_password
MQTT_DEVICE_USERNAME=demo_device
MQTT_DEVICE_PASSWORD=replace_with_a_local_password

MYSQL_ROOT_PASSWORD=replace_with_a_local_root_password
# The initialization SQL uses this database name.
MYSQL_DATABASE=fic_data
MYSQL_USER=fic_db_user
MYSQL_PASSWORD=replace_with_a_local_db_password
# Compose passes MYSQL_PASSWORD to the microservices as DBPASSWORD.
